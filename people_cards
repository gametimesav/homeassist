              }
      - type: map
        entities:
          - entity: person.office_mike
          - entity: person.callie
          - entity: zone.home
          - entity: zone.work
        aspect_ratio: '4:2'
        dark_mode: true
        style: |
          ha-card { 
            font-size: 20px;
          }
