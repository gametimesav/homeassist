# Configure logging over USB Serial
logger:
  baud_rate: 115200

sensor:
  # Configure your physical DHT11 sensor with an explicit conversion filter
  - platform: dht
    pin: GPIO4
    temperature:
      name: "Room Temperature"
      id: room_temp
      unit_of_measurement: "°F"
      # This forces the raw Celsius reading to convert to Fahrenheit on-chip
      filters:
        - lambda: return x * 1.8 + 32.0;
    humidity:
      name: "Room Humidity"
      id: room_humidity
    model: DHT11
    update_interval: 60s

  # Calculate and display the Heat Index (now receiving proper Fahrenheit inputs)
  - platform: template
    name: "Room Heat Index"
    id: room_heat_index
    unit_of_measurement: "°F"
    icon: "mdi:thermometer-alert"
    accuracy_decimals: 1
    lambda: |-
      if (id(room_temp).has_state() && id(room_humidity).has_state()) {
        float t_f = id(room_temp).state; 
        float rh = id(room_humidity).state;
        
        // Steadman simple formula
        float hi_f = 0.5 * (t_f + 61.0 + ((t_f - 68.0) * 1.2) + (rh * 0.094));
        
        // Full Rothfusz regression equation for high heat scenarios
        if (hi_f >= 80.0) {
          hi_f = -42.379 + 2.04901523*t_f + 10.14333127*rh - 0.22475541*t_f*rh 
                 - 0.00683783*t_f*t_f - 0.05481717*rh*rh + 0.00122874*t_f*t_f*rh 
                 + 0.00085282*t_f*rh*rh - 0.00000199*t_f*t_f*rh*rh;
                 
          if (rh < 13.0 && t_f >= 80.0 && t_f <= 112.0) {
            hi_f -= ((13.0 - rh) / 4.0) * sqrt((17.0 - abs(t_f - 95.0)) / 17.0);
          } else if (rh > 85.0 && t_f >= 80.0 && t_f <= 87.0) {
            hi_f += ((rh - 85.0) / 10.0) * ((87.0 - t_f) / 5.0);
          }
        }
        
        return hi_f;
      } else {
        return NAN;
      }
# 2. Motion Binary Sensor (AM312)
binary_sensor:
  - platform: gpio
    pin: 
      number: GPIO33
      mode:
        input: true    # Activates the ESP internal pull-down
    filters:
      - delayed_off: 10s
      - delayed_on: 2s # Ignores any electrical/Wi-Fi spikes shorter than 100ms
    name: "Multi Room Motion"
    device_class: motion

ota:
  - platform: esphome
    id: ota_esphome_1
