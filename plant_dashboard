button_card_templates:
  person_card:
    show_name: false
    show_icon: false
    aspect_ratio: 1/1
    tap_action:
      action: more-info
    hold_action:
      action: more-info
    styles:
      card:
        - padding: 0
        - overflow: hidden
        - border-radius: 18px
        - border: 1px solid rgba(255,255,255,0.08)
        - box-shadow: 0 6px 18px rgba(0,0,0,0.20)
        - background-image: |
            [[[
              return `
                linear-gradient(
                  180deg,
                  rgba(0,0,0,0.05) 0%,
                  rgba(0,0,0,0.02) 50%,
                  rgba(0,0,0,0.70) 100%
                ),
                url("${variables.person_image}")
              `;
            ]]]
        - background-size: cover
        - background-repeat: no-repeat
        - background-position: center bottom
        - --keep-background: 'true'
      grid:
        - grid-template-areas: |
            "location steps battery"
            ". . ."
            "person person person"
        - grid-template-columns: 1fr auto 1fr
        - grid-template-rows: auto 1fr auto
        - width: 100%
        - height: 100%
      custom_fields:
        location:
          - justify-self: start
          - align-self: start
          - margin: 10px 0 0 10px
          - z-index: 2
        steps:
          - justify-self: center
          - align-self: start
          - margin-top: 10px
          - z-index: 2
        battery:
          - justify-self: end
          - align-self: start
          - margin: 10px 10px 0 0
          - z-index: 2
        person:
          - justify-self: stretch
          - align-self: end
          - padding: 12px 14px 14px 14px
          - z-index: 2
    custom_fields:
      location: |
        [[[
          const person = states[variables.person_entity];
          const network = states[variables.network_entity]?.state;

          const state = person?.state ?? "unknown";

          let icon = "mdi:map-marker-radius";
          let color = "#f0a33a";
          let label = "Away";

          if (state === "home" || network === "on") {
            icon = "mdi:home";
            color = "#57c26b";
            label = "Home";
          }

          else if (state.toLowerCase() === "work") {
            icon = "mdi:office-building";
            color = "#5fa8ff";
            label = "Work";
          }

          else if (
            state === "unknown" ||
            state === "unavailable"
          ) {
            icon = "mdi:map-marker-question";
            color = "#9e9e9e";
            label = "Unknown";
          }

          else if (state !== "not_home") {
            icon = "mdi:map-marker";
            color = "#f0a33a";

            label = state
              .replaceAll("_", " ")
              .replace(/\b\w/g, c => c.toUpperCase());
          }

          return `
            <div style="
              display:flex;
              align-items:center;
              gap:5px;
              padding:5px 8px;
              border-radius:14px;
              background:rgba(18,18,18,0.58);
              backdrop-filter:blur(8px);
              -webkit-backdrop-filter:blur(8px);
              box-shadow:0 2px 6px rgba(0,0,0,0.25);
              color:white;
              font-size:11px;
              font-weight:600;
              white-space:nowrap;
            ">
              <ha-icon
                icon="${icon}"
                style="
                  width:16px;
                  height:16px;
                  color:${color};
                ">
              </ha-icon>

              <span>${label}</span>
            </div>
          `;
        ]]]
      steps: |
        [[[
          const obj = states[variables.steps_entity];
          const raw = obj?.state;
          const value = Number(raw);

          let text = "--";
          let color = "#9e9e9e";

          if (
            raw &&
            raw !== "unknown" &&
            raw !== "unavailable" &&
            !Number.isNaN(value)
          ) {
            text = value.toLocaleString();

            if (value >= 10000) {
              color = "#57c26b";
            }
            else if (value >= 5000) {
              color = "#f0a33a";
            }
            else {
              color = "#ef6258";
            }
          }

          return `
            <div style="
              display:flex;
              align-items:center;
              gap:5px;
              padding:5px 8px;
              border-radius:14px;
              background:rgba(18,18,18,0.58);
              backdrop-filter:blur(8px);
              -webkit-backdrop-filter:blur(8px);
              box-shadow:0 2px 6px rgba(0,0,0,0.25);
              color:white;
              font-size:11px;
              font-weight:600;
              white-space:nowrap;
            ">
              <ha-icon
                icon="mdi:walk"
                style="
                  width:16px;
                  height:16px;
                  color:${color};
                ">
              </ha-icon>

              <span>${text}</span>
            </div>
          `;
        ]]]
      battery: |
        [[[
          const obj = states[variables.battery_entity];
          const raw = obj?.state;
          const bat = Number(raw);

          if (
            !raw ||
            raw === "unknown" ||
            raw === "unavailable" ||
            Number.isNaN(bat)
          ) {
            return `
              <div style="
                display:flex;
                align-items:center;
                gap:5px;
                padding:5px 8px;
                border-radius:14px;
                background:rgba(18,18,18,0.58);
                backdrop-filter:blur(8px);
                -webkit-backdrop-filter:blur(8px);
                box-shadow:0 2px 6px rgba(0,0,0,0.25);
                color:white;
                font-size:11px;
                font-weight:600;
                white-space:nowrap;
              ">
                <ha-icon
                  icon="mdi:battery-unknown"
                  style="
                    width:16px;
                    height:16px;
                    color:#9e9e9e;
                  ">
                </ha-icon>

                <span>--%</span>
              </div>
            `;
          }

          let icon = "mdi:battery";

          if (bat < 10) icon = "mdi:battery-10";
          else if (bat < 20) icon = "mdi:battery-20";
          else if (bat < 30) icon = "mdi:battery-30";
          else if (bat < 40) icon = "mdi:battery-40";
          else if (bat < 50) icon = "mdi:battery-50";
          else if (bat < 60) icon = "mdi:battery-60";
          else if (bat < 70) icon = "mdi:battery-70";
          else if (bat < 80) icon = "mdi:battery-80";
          else if (bat < 90) icon = "mdi:battery-90";

          let color = "#57c26b";

          if (bat <= 20) {
            color = "#ef6258";
          }
          else if (bat <= 40) {
            color = "#f0a33a";
          }

          return `
            <div style="
              display:flex;
              align-items:center;
              gap:5px;
              padding:5px 8px;
              border-radius:14px;
              background:rgba(18,18,18,0.58);
              backdrop-filter:blur(8px);
              -webkit-backdrop-filter:blur(8px);
              box-shadow:0 2px 6px rgba(0,0,0,0.25);
              color:white;
              font-size:11px;
              font-weight:600;
              white-space:nowrap;
            ">
              <ha-icon
                icon="${icon}"
                style="
                  width:16px;
                  height:16px;
                  color:${color};
                ">
              </ha-icon>

              <span>${Math.round(bat)}%</span>
            </div>
          `;
        ]]]
      person: |
        [[[
          const person = states[variables.person_entity];
          const network = states[variables.network_entity]?.state;

          const state = person?.state ?? "unknown";

          let text = "Away";
          let dot = "#f0a33a";

          if (state === "home" || network === "on") {
            text = "Home";
            dot = "#57c26b";
          }

          else if (state.toLowerCase() === "work") {
            text = "At Work";
            dot = "#5fa8ff";
          }

          else if (
            state === "unknown" ||
            state === "unavailable"
          ) {
            text = "Location unavailable";
            dot = "#9e9e9e";
          }

          else if (state !== "not_home") {
            text = state
              .replaceAll("_", " ")
              .replace(/\b\w/g, c => c.toUpperCase());
          }

          return `
            <div style="
              display:flex;
              flex-direction:column;
              align-items:flex-start;
              color:white;
              text-shadow:0 1px 4px rgba(0,0,0,0.8);
            ">

              <div style="
                font-size:20px;
                font-weight:700;
                line-height:1.1;
              ">
                ${variables.person_name}
              </div>

              <div style="
                display:flex;
                align-items:center;
                gap:6px;
                margin-top:4px;
                font-size:11px;
                font-weight:500;
                opacity:0.92;
              ">

                <span style="
                  width:7px;
                  height:7px;
                  border-radius:50%;
                  background:${dot};
                  box-shadow:0 0 5px ${dot};
                ">
                </span>

                ${text}

              </div>

            </div>
          `;
        ]]]
